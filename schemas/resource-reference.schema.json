{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Plane Resource Reference",
  "type": "object",
  "properties": {
    "urn": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "x-graphql-scalar": "URN"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "byteLength": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "x-graphql-scalar": "Revision"
    }
  },
  "required": [
    "urn",
    "sha256",
    "mediaType",
    "byteLength"
  ],
  "additionalProperties": false
}
